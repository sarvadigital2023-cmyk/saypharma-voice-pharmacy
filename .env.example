# Retell AI voice agent (server-side only — never expose the API key to the
# browser). Copy to ".env" for local dev, and set the same vars in
# Vercel → Settings → Environment Variables for production.

# Your Retell secret API key (Retell dashboard → API Keys). REQUIRED.
RETELL_API_KEY=

# Optional — defaults to the published "Cimo" agent in code
# (agent_ab40edc3f65fa8dc35bea4ef84). Set only to point at a different agent.
RETELL_AGENT_ID=agent_ab40edc3f65fa8dc35bea4ef84

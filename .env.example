# Retell AI voice agent (server-side only — never expose these to the browser).
# Copy to ".env" for local dev, and set the same vars in Vercel → Settings →
# Environment Variables for production.

# Your Retell secret API key (Retell dashboard → API Keys)
RETELL_API_KEY=

# The agent that the "Talk to SayPharma" button calls (agent "Cimo")
RETELL_AGENT_ID=

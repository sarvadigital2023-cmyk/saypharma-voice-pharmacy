# Server-side env (set in Vercel → Settings → Environment Variables).
# Copy to ".env" for local dev. Never expose secrets to the browser.

# --- Retell voice agent (Cimo) -----------------------------------------
# Your Retell secret API key (Retell dashboard → API Keys). REQUIRED.
RETELL_API_KEY=
# Optional — defaults to the published "Cimo" agent in code.
RETELL_AGENT_ID=agent_ab40edc3f65fa8dc35bea4ef84

# --- Supabase (read/write from the agent tool endpoints) ----------------
SUPABASE_URL=
# Service role key — secret, server only. Used by /api/agent/* endpoints.
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent tool-call auth ----------------------------------------------
# Shared secret the Retell tools send as the "x-agent-secret" header.
# Generate any long random string; put the SAME value here and in Retell.
AGENT_TOOL_SECRET=

# --- Pharmacy settings --------------------------------------------------
# IANA timezone used to compute "open now" from pharmacy_settings.working_hours.
# Defaults to Europe/Sofia (matches the stored pharmacy location).
PHARMACY_TIMEZONE=Europe/Sofia

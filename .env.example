# Vapi voice agent (the agent "Cimo" is defined in code — no dashboard agent,
# no agent id). Copy to ".env" for local dev and set the same vars in
# Vercel → Settings → Environment Variables for production.

# Your Vapi PUBLIC key (Vapi dashboard → API Keys → Public Key).
# This is a publishable client key (exposed to the browser via VITE_) — safe.
VITE_VAPI_PUBLIC_KEY=

# Optional: a specific voice id (e.g. ElevenLabs "Rita"). Defaults to a
# pleasant multilingual female voice if left empty.
VITE_VAPI_VOICE_ID=
